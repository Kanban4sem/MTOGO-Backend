{
  "uid": "mtogo",
  "title": "MTOGO",
  "description": "Stage and prod against their targets (ADR-008). Provisioned from deploy/monitoring: changes made here are not saved.",
  "tags": ["mtogo"],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "stage,prod",
        "multi": true,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": ["stage", "prod"],
          "value": ["stage", "prod"]
        },
        "options": [
          {
            "selected": true,
            "text": "stage",
            "value": "stage"
          },
          {
            "selected": true,
            "text": "prod",
            "value": "prod"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "API",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "p95 latency \u00b7 $env",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backend\", env=\"$env\", uri=~\"/v1/.*\"}[5m]))) and on() (sum(rate(http_server_requests_seconds_count{job=\"backend\", env=\"$env\", uri=~\"/v1/.*\"}[5m])) > 0)",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "description": "95% of API requests over the last 5 minutes were faster than this. Target: under 500 ms.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "repeat": "env",
      "repeatDirection": "h",
      "maxPerRow": 2
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "5xx rate \u00b7 $env",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 0.02,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"backend\", env=\"$env\", uri=~\"/v1/.*\", status=~\"5..\"}[5m])) or on() vector(0)) / (sum(rate(http_server_requests_seconds_count{job=\"backend\", env=\"$env\", uri=~\"/v1/.*\"}[5m])) > 0)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "description": "Share of API requests over the last 5 minutes that answered with a 5xx status. Target: under 1%.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "repeat": "env",
      "repeatDirection": "h",
      "maxPerRow": 2
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Availability \u00b7 $env",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(up{job=\"backend\", env=\"$env\"}[$__range])",
          "legendFormat": "availability",
          "refId": "A"
        }
      ],
      "description": "Share of Prometheus's scrapes of the backend that succeeded over the dashboard's time range. Target: at least 99.9%.",
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "repeat": "env",
      "repeatDirection": "h",
      "maxPerRow": 2
    },

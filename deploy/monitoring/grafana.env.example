# Copy to /opt/mtogo/monitoring/grafana.env on the server and fill in the values.
# Never commit the real file. Create the password with: openssl rand -base64 32
# Grafana reads these only on its first start, while grafana-data is empty. Change the password later in Grafana.
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

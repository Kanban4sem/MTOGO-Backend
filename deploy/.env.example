# Copy to /opt/mtogo/<environment>/.env on the server and fill in the values.
# Never commit the real file. Create secrets with: openssl rand -base64 48
ENV_NAME=stage
PUBLIC_HOST=stage.mtogo.saldic.dev
# deploy.sh fills in the tags
BACKEND_TAG=
FRONTEND_TAG=
DB_PASSWORD=
# Not read by the backend until JWT is built. Use a different value in stage and prod
JWT_SECRET=

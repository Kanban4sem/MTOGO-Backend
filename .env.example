# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Use localhost instead if Java runs directly on the host.
DB_URL=jdbc:postgresql://host.docker.internal:5432/mtogo
DB_USER=mtogo
DB_PASSWORD=change-me
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Local pgAdmin (separate from the database login)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050

# Seeded users (ADR-006, docs/local-development.md "Seeded users"). Set a role's password to create its users on startup.
# Leave empty to skip that role. At least 8 characters and at most 72 UTF-8 bytes.
SEED_CUSTOMER_PASSWORD=
SEED_RESTAURANT_PASSWORD=
SEED_DELIVERY_AGENT_PASSWORD=
SEED_ADMIN_PASSWORD=

# Required: the backend does not start without it. Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_LIFETIME_SECONDS=900

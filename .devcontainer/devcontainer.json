{
  "name": "MTOGO Backend",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": "false"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "mounts": [
    "source=mtogo-claude,target=/home/vscode/.claude,type=volume",
    "source=mtogo-codex,target=/home/vscode/.codex,type=volume"
  ],
  "postCreateCommand": "gh ext install devx-cafe/gh-insitu && gh insitu run post-create install-agents",
  "postStartCommand": "bash .devcontainer/start-pgadmin.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "MTOGO Backend"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "DavidAnson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": {
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "MTOGO_SKIP_CLAUDE": "${localEnv:MTOGO_SKIP_CLAUDE}",
    "MTOGO_SKIP_CODEX": "${localEnv:MTOGO_SKIP_CODEX}",
    "MTOGO_TEST_FORKS": "${localEnv:MTOGO_TEST_FORKS:1}"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  }
}
